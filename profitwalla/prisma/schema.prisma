generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  submitted
  reviewing
  approved
  rejected
  pushed
}

model Client {
  id                        String         @id @default(uuid())
  fullName                  String
  mobile                    String         @unique
  mobileVerified            Boolean        @default(false)
  occupation                String?
  business                  String?
  mt5AccountNumber          String
  mt5InvestorPasswordEnc    String
  mt5InvestorPasswordIv     String
  brokerServer              String
  serverName                String?
  startingEquity            Float
  city                      String
  state                     String
  consentGiven              Boolean        @default(false)
  consentTimestamp          DateTime?
  status                    ClientStatus   @default(submitted)
  adminNotes                String?
  pushedToCopyTrading       Boolean        @default(false)
  pushedAt                  DateTime?
  copyTradingClientId       String?
  auditLogs                 AuditLog[]

  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([status])
  @@index([mobile])
  @@unique([mt5AccountNumber])
}

model AuditLog {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  action        String
  performedBy   String
  details       String?
  ipAddress     String?

  createdAt     DateTime @default(now())

  @@index([clientId])
  @@index([action])
  @@index([createdAt])
}

model AdminUser {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          String   @default("admin")
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  lastLoginAt   DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RateLimitEntry {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
