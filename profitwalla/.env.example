DATABASE_URL="postgresql://postgres:postgres@localhost:5432/profitwalla"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"
NEXTAUTH_URL="https://profitwalla.com"

# Encryption key for AES-256-GCM (generate a new one for production)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="generate-a-new-key"

# Internal API secret (must match copytrading's INTER_SYSTEM_API_SECRET)
INTER_SYSTEM_API_SECRET="change-this-to-a-strong-random-secret"

# MetaApi Configuration (for copy trading)
METAAPI_TOKEN=""
METAAPI_MASTER_ACCOUNT_ID=""

# Cron secret for protecting cron endpoints
CRON_SECRET="change-this-to-a-strong-random-secret"

# Seed secret for /api/seed endpoint
SEED_SECRET="change-this-to-a-strong-random-secret"

# Copy trading system URL
COPYTRADING_API_URL="https://copytrading.profitwalla.com"

# Resend API key for email notifications
RESEND_API_KEY="re_your_api_key_here"

# Client dashboard token secret (for client auth tokens)
CLIENT_TOKEN_SECRET="change-this-to-a-strong-random-secret"
