DATABASE_URL="postgresql://postgres:postgres@localhost:5432/copytrading"
NEXTAUTH_SECRET="your-copytrading-nextauth-secret"
NEXTAUTH_URL="http://localhost:3001"

# Encryption key (MUST match System 1's key for credential compatibility)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Internal API secret (must match System 1's INTER_SYSTEM_API_SECRET)
INTER_SYSTEM_API_SECRET="change-this-to-a-strong-random-secret"

# MetaApi Configuration
METAAPI_TOKEN=""
METAAPI_MASTER_ACCOUNT_ID=""
# MetaApi account region (new-york | frankfurt | singapore | london | sydney ...). Defaults to new-york.
METAAPI_REGION="new-york"
# Optional override for the client API host (e.g. custom domain). Defaults to mt-client-api-v1.<region>.agiliumtrade.ai
METAAPI_BASE_URL=""

# Copy Engine Configuration
COPY_POLL_INTERVAL_MS="5000"
STALE_EXECUTION_TIMEOUT_MS="300000"
MAX_RETRIES="3"

# Reconciliation Configuration
RECONCILIATION_INTERVAL_MS="300000"
RECONCILIATION_PRICE_TOLERANCE="0.02"
RECONCILIATION_VOLUME_TOLERANCE="0.005"
RECONCILIATION_SL_TP_TOLERANCE="0.01"
RECONCILIATION_MAX_CONCURRENT="5"

# Health Check Configuration
HEALTH_CHECK_INTERVAL_MS="300000"
HEALTH_STALE_THRESHOLD_MS="120000"

# System 1 API URL (for webhook callbacks)
PROFITWALLA_API_URL="http://localhost:3000"

# Seed configuration (NEVER use default passwords in production)
SEED_STAFF_EMAIL="staff@profitwalla.local"
SEED_STAFF_PASSWORD=""
SEED_STAFF_NAME="Staff"

# Seed secret for /api/seed endpoint
SEED_SECRET="change-this-to-a-strong-random-secret"
